# ============================================================
# Website Replacement Demo - 環境変数サンプル
# ------------------------------------------------------------
# 使い方:
#   1. このファイルをコピーして .env にリネーム
#        cp .env.example .env
#   2. 下記 GEMINI_API_KEY_1〜3 に API キーを設定
#   3. `npm start` でサーバー起動
#
# 注意:
#   .env ファイルは .gitignore に含まれているため GitHub に
#   アップロードされません。APIキーは絶対にコミットしないこと。
# ============================================================

# Google AI Studio で取得した Gemini API キー (最低1つ必須)
#   取得先: https://aistudio.google.com/app/apikey
#   無料枠は 1キー x 1モデル あたり 20回/日
#   3つ登録すると 合計 120回/日 まで使える
GEMINI_API_KEY_1=your-gemini-api-key-1-here
GEMINI_API_KEY_2=your-gemini-api-key-2-here
GEMINI_API_KEY_3=your-gemini-api-key-3-here

# 使用するモデル (省略可, 既定: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# 起動ポート (省略可, 既定: 3000)
PORT=3000
