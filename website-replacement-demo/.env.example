# ============================================================
# Website Replacement Demo - 環境変数サンプル
# ------------------------------------------------------------
# 使い方:
#   1. このファイルをコピーして .env にリネーム
#        cp .env.example .env
#   2. 下記 GEMINI_API_KEY に自分のAPIキーを設定
#   3. `npm start` でサーバー起動
#
# 注意:
#   .env ファイルは .gitignore に含まれているため GitHub に
#   アップロードされません。APIキーは絶対にコミットしないこと。
# ============================================================

# Google AI Studio で取得した Gemini API キー (必須)
#   取得先: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 使用するモデル (省略可, 既定: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# 起動ポート (省略可, 既定: 3000)
PORT=3000
